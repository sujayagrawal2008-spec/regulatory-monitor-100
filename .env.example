# ─────────────────────────────────────────────────────────────────
# Regulatory Monitor — Environment Variables
# Copy this file to .env for local overrides (optional).
# On Railway, set these in the Railway dashboard → Variables tab.
# ─────────────────────────────────────────────────────────────────

# Port — Railway sets this automatically. Do NOT set it manually on Railway.
# PORT=3000

# Path to persistent data directory.
# On Railway: set to /data (the Volume mount point).
# Locally: leave unset (defaults to ./data).
DATA_DIR=/data

# ── Email (Gmail SMTP) ────────────────────────────────────────────
# This is the SENDER account only — recipients are managed as subscribers
# in the Email Alerts tab (each with their own keywords/description), not here.
# Use a Gmail App Password, NOT your real Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# ── AI features ──────────────────────────────────────────────────
# Anthropic Claude (claude-haiku-4-5) — powers PDF summaries, the AI Assistant
# chat (RAG), Document Q&A, Compliance Checker, and the Document Validity
# Checker's Stage 2 semantic supersession check.
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
