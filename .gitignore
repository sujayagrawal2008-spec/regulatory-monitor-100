# Node
node_modules/

# Local data — both files are deliberately tracked in this repo
# (regulatory-monitor-100 only) so Render deploys start from the
# already-processed corpus and real subscriber list instead of empty.
# config.json has its email.host/user/pass/enabled fields stripped —
# SMTP_USER/SMTP_PASS are set as Render env vars instead.
data/*
!data/store.json
!data/config.json

# Local environment overrides
.env
.env.local

# Dev utility scripts (safe to delete)
debug_ibbi.js
probe_all.js
debug.js
sample.js

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/

# Server run logs (local debugging only)
server*.log

# Unrelated scratch project accidentally nested in this folder
AI-assistent-sunhacks/
